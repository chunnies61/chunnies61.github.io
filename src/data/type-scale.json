{
  "note": "Material Design 3 type scale, 15 roles. Sizes, line-heights and letter-spacings are the MD3 values. Weights and families are this site's: Bricolage Grotesque 700 for Display and Headline, Poppins 500 for Title, Body and Label. Mirrored as .md-* classes in src/index.css — change both together.",
  "groups": [
    {
      "name": "Display",
      "family": "Bricolage Grotesque",
      "familyToken": "--font-display",
      "weight": 700,
      "use": "Hero moments and page headers. Sparingly — one per screen.",
      "roles": [
        { "role": "Display Large", "class": "md-display-large", "size": 56, "lineHeight": 64, "letterSpacing": -0.25 },
        { "role": "Display Medium", "class": "md-display-medium", "size": 45, "lineHeight": 52, "letterSpacing": 0 },
        { "role": "Display Small", "class": "md-display-small", "size": 36, "lineHeight": 44, "letterSpacing": 0 }
      ]
    },
    {
      "name": "Headline",
      "family": "Bricolage Grotesque",
      "familyToken": "--font-display",
      "weight": 700,
      "use": "Section headings — the level a reader scans to find their place.",
      "roles": [
        { "role": "Headline Large", "class": "md-headline-large", "size": 32, "lineHeight": 40, "letterSpacing": 0 },
        { "role": "Headline Medium", "class": "md-headline-medium", "size": 28, "lineHeight": 36, "letterSpacing": 0 },
        { "role": "Headline Small", "class": "md-headline-small", "size": 24, "lineHeight": 32, "letterSpacing": 0 }
      ]
    },
    {
      "name": "Title",
      "family": "Poppins",
      "familyToken": "--font-ui",
      "weight": 500,
      "use": "Card, panel and list-item headings — shorter than a headline, heavier than body.",
      "roles": [
        { "role": "Title Large", "class": "md-title-large", "size": 22, "lineHeight": 28, "letterSpacing": 0 },
        { "role": "Title Medium", "class": "md-title-medium", "size": 16, "lineHeight": 24, "letterSpacing": 0.15 },
        { "role": "Title Small", "class": "md-title-small", "size": 14, "lineHeight": 20, "letterSpacing": 0.1 }
      ]
    },
    {
      "name": "Body",
      "family": "Poppins",
      "familyToken": "--font-ui",
      "weight": 500,
      "use": "Running prose. Body Large is the default reading size.",
      "roles": [
        { "role": "Body Large", "class": "md-body-large", "size": 16, "lineHeight": 24, "letterSpacing": 0.5 },
        { "role": "Body Medium", "class": "md-body-medium", "size": 14, "lineHeight": 20, "letterSpacing": 0.25 },
        { "role": "Body Small", "class": "md-body-small", "size": 12, "lineHeight": 16, "letterSpacing": 0.4 }
      ]
    },
    {
      "name": "Label",
      "family": "Poppins",
      "familyToken": "--font-ui",
      "weight": 600,
      "use": "Buttons, tabs, eyebrows, captions — text attached to a control or a thing.",
      "roles": [
        { "role": "Label Large", "class": "md-label-large", "size": 14, "lineHeight": 20, "letterSpacing": 0.1 },
        { "role": "Label Medium", "class": "md-label-medium", "size": 12, "lineHeight": 16, "letterSpacing": 0.5 },
        { "role": "Label Small", "class": "md-label-small", "size": 11, "lineHeight": 16, "letterSpacing": 0.5 }
      ]
    }
  ]
}
