{
  "note": "Material Design 3 type scale, 15 roles. Sizes, line-heights and letter-spacings are the MD3 values. Weights and families are this site's: Bricolage Grotesque 800 for Display, 700 for Headline, Poppins 500 for Title, Body and Label. Line height is 130% of the size for Display and Headline, 160% for Title, Body and Label. Mirrored as .md-* classes in src/index.css — change both together.",
  "groups": [
    {
      "name": "Display",
      "family": "Bricolage Grotesque",
      "familyToken": "--font-display",
      "weight": 800,
      "use": "Hero moments and page headers. Sparingly — one per screen. Line height runs 130% of the size.",
      "roles": [
        {
          "role": "Display Large",
          "class": "md-display-large",
          "size": 56,
          "lineHeight": 72.8,
          "letterSpacing": 0
        },
        {
          "role": "Display Medium",
          "class": "md-display-medium",
          "size": 45,
          "lineHeight": 58.5,
          "letterSpacing": 0
        },
        {
          "role": "Display Small",
          "class": "md-display-small",
          "size": 36,
          "lineHeight": 46.8,
          "letterSpacing": 0
        }
      ]
    },
    {
      "name": "Headline",
      "family": "Bricolage Grotesque",
      "familyToken": "--font-display",
      "weight": 700,
      "use": "Section headings — the level a reader scans to find their place. Line height runs 130% of the size.",
      "roles": [
        {
          "role": "Headline Large",
          "class": "md-headline-large",
          "size": 32,
          "lineHeight": 41.6,
          "letterSpacing": 0
        },
        {
          "role": "Headline Medium",
          "class": "md-headline-medium",
          "size": 28,
          "lineHeight": 36.4,
          "letterSpacing": 0
        },
        {
          "role": "Headline Small",
          "class": "md-headline-small",
          "size": 20,
          "lineHeight": 26,
          "letterSpacing": 0
        }
      ]
    },
    {
      "name": "Title",
      "family": "Poppins",
      "familyToken": "--font-ui",
      "weight": 500,
      "use": "Card, panel and list-item headings — shorter than a headline, heavier than body. Line height runs 160% of the size.",
      "roles": [
        {
          "role": "Title Large",
          "class": "md-title-large",
          "size": 22,
          "lineHeight": 35.2,
          "letterSpacing": 0
        },
        {
          "role": "Title Medium",
          "class": "md-title-medium",
          "size": 16,
          "lineHeight": 25.6,
          "letterSpacing": 0.15
        },
        {
          "role": "Title Small",
          "class": "md-title-small",
          "size": 14,
          "lineHeight": 22.4,
          "letterSpacing": 0.1
        }
      ]
    },
    {
      "name": "Body",
      "family": "Poppins",
      "familyToken": "--font-ui",
      "weight": 500,
      "use": "Running prose. Body Large is the default reading size. Line height runs 160% of the size.",
      "roles": [
        {
          "role": "Body Large",
          "class": "md-body-large",
          "size": 16,
          "lineHeight": 25.6,
          "letterSpacing": 0.5
        },
        {
          "role": "Body Medium",
          "class": "md-body-medium",
          "size": 14,
          "lineHeight": 22.4,
          "letterSpacing": 0.25
        },
        {
          "role": "Body Small",
          "class": "md-body-small",
          "size": 12,
          "lineHeight": 19.2,
          "letterSpacing": 0.4
        }
      ]
    },
    {
      "name": "Label",
      "family": "Poppins",
      "familyToken": "--font-ui",
      "weight": 600,
      "use": "Buttons, tabs, eyebrows, captions — text attached to a control or a thing. Line height runs 160% of the size.",
      "roles": [
        {
          "role": "Label Large",
          "class": "md-label-large",
          "size": 14,
          "lineHeight": 22.4,
          "letterSpacing": 0.1
        },
        {
          "role": "Label Medium",
          "class": "md-label-medium",
          "size": 12,
          "lineHeight": 19.2,
          "letterSpacing": 0.5
        },
        {
          "role": "Label Small",
          "class": "md-label-small",
          "size": 11,
          "lineHeight": 17.6,
          "letterSpacing": 0.5
        }
      ]
    }
  ]
}
